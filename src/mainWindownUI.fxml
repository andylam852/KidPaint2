<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <Pane fx:id="container" style="-fx-background-color:#222;" BorderPane.alignment="CENTER">
            <Canvas fx:id="canvas" />
        </Pane>
    </center>
    <top>
        <BorderPane>
            <left>
                <ToolBar prefHeight="40.0" prefWidth="200.0">
                    <items>
                        <ChoiceBox fx:id="chbMode" prefWidth="80.0">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Pen"/>
                                    <String fx:value="Bucket"/>
                                    <String fx:value="Eraser"/>
                                </FXCollections>
                            </items>
                        </ChoiceBox>
                        <!-- Black color preview -->
                        <Pane fx:id="paneColor" prefWidth="30.0" prefHeight="30.0" />
                        <!-- Arrow button placed immediately to the right of the black color picker -->
                        <Button fx:id="btnColorMap" text="▼" prefWidth="28.0" prefHeight="28.0" />
                        <!-- Small inline color map picker -->
                        <Pane fx:id="panePicker" prefWidth="30.0" prefHeight="30.0" />
                    </items>
                </ToolBar>
            </left>
            <right>
                <ToolBar prefHeight="40.0">
                    <items>
                        <Button fx:id="btnBack" text="Back" />
                        <Button fx:id="btnLoad" text="Load" />
                        <Button fx:id="btnSave" text="Save" />
                        <Button fx:id="btnClear" text="Clear" />
                    </items>
                </ToolBar>
            </right>
        </BorderPane>
    </top>
    <right>
        <VBox prefWidth="300.0" minWidth="300.0">
            <TextArea fx:id="areaMsg" wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox spacing="8">
                <Button fx:id="btnEmoji" text="Emoji"
                        prefWidth="90.0" prefHeight="34.0"
                        style="-fx-font-size:14px;" />
                <TextField fx:id="txtMsg" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSend" text="Send"
                        prefWidth="90.0" prefHeight="34.0"
                        style="-fx-font-size:14px;" />
            </HBox>
        </VBox>
    </right>
</BorderPane>
